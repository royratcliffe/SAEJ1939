    "object": {
      "Graph": {
        "@Type": "2db5746d",
        "@Value": {
          "Interface": {
            "@Type": "a9ed5b7e",
            "@Value": {
              "TextDocument": {
                "@Type": "f3878285",
                "@Value": {
                  "TextBlobForSerialisation": "(string){attribute 'qualified_only'}\n{attribute 'strict'}\n(* Engine Operating Information (EOI) contains engine parameters related\nto operation. The Engine Operating State indicates the engine's current\noperating state or mode. *)\nTYPE EngineOperatingState : (\n        EngineStopped               := 2#0000,\n        PreStart                    := 2#0001,\n        Starting                    := 2#0010,\n        WarmUp                      := 2#0011,\n        Running                     := 2#0100,\n        CoolDown                    := 2#0101,\n        EngineStopping              := 2#0110,\n        PostRun                     := 2#0111,\n        AvailableForSAEAssignment8  := 2#1000,\n        AvailableForSAEAssignment9  := 2#1001,\n        AvailableForSAEAssignment10 := 2#1010,\n        AvailableForSAEAssignment11 := 2#1011,\n        AvailableForSAEAssignment12 := 2#1100,\n        AvailableForSAEAssignment13 := 2#1101,\n        Reserved                    := 2#1110,\n        NotAvailable                := 2#1111\n    );\nEND_TYPE",
                  "LineInfoPersistence": "(string)c6324bbc-fc60-4d6d-96b9-da659b1f0b0d_Decl_LineIds"
                }
              }
            }
          },
          "UniqueIdGenerator": "(string)159"
        }
      },
      "TypeInfos": {
        "2db5746d": "{2db5746d-d284-4425-9f7f-2663a34b0ebc}",
